{
  "name": "jsplayground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "provision": "npm install --legacy-peer-deps && npm run lint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "npm run predeploy && gh-pages -d dist"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@uiw/codemirror-extensions-basic-setup": "4.25.12",
    "@uiw/react-codemirror": "4.25.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "espree": "11.2.0",
    "jotai": "3.0.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-fast-compare": "3.2.2",
    "react-resizable-panels": "4.20.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@babel/standalone": "8.1.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/babel__standalone": "7.1.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "gh-pages": "6.3.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
